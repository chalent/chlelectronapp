# Normalize text files across platforms.
* text=auto

# Keep common source and configuration files as LF in the repository.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.scss text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Preserve Windows command scripts with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
